<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Version>1.0.2</Version>
		<Version Condition="'$(VersionToUse)' != ''">$(VersionToUse)</Version>		
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageOutputPath>$(OutPutPathTasks)</PackageOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="AssemblyInfo.fs" />
		<Compile Include="XmlHelper.fs" />
		<Compile Include="RoslynHelper.fs" />
		<Compile Include="SonarHelpers.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Features" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
		<PackageReference Include="MsbuildAutomationHelper" Version="3.1.0" />
		<PackageReference Include="Trimble.SonarRestApiImpl " Version="1.9.0" />
	</ItemGroup>
	<Target Name="ZipOutput" AfterTargets="Build">
		<PropertyGroup>
			<!-- Define the output folder and zip file name -->
			<OutputFolder>$(OutDir)</OutputFolder>
			<ZipFileName>RoslynRunner.zip</ZipFileName>
		</PropertyGroup>

		<!-- Create the zip file using MSBuild's Zip task -->
		<ItemGroup>
			<FilesToZip Include="$(OutputFolder)\**\*" />
		</ItemGroup>
		<Message Text="OutputFolder: $(OutputFolder) witth version: $(VersionToUse)" Importance="High" />
		<Exec Command="powershell -ExecutionPolicy ByPass -File compress.ps1 -sourcePath $(OutputFolder) -destinationPath ..\target\$(ZipFileName)" />
		<Exec Command="mvn install:install-file -Dfile=../target/$(ZipFileName) -DgroupId=org.jmecsoftware.com.sonar-plugins.dotnet.roslyn -DartifactId=RoslynRunner -Dversion=$(Version) -Dpackaging=zip" />
	</Target>
</Project>